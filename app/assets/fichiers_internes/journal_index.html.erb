<%# ─────────────────────────────────────────────────────────────────────
    app/views/health_entries/index.html.erb
    Mon journal — frise temporelle chronologique, charte Nommer
───────────────────────────────────────────────────────────────────── %>

<%
  # Configuration des types : icône, couleur, label
  type_config = {
    "symptom" => {
      icon: "🔴",
      color: "#C0785A",   # accent terracotta
      bg_light: "#F4E4D9",
      label: "Symptôme"
    },
    "consultation" => {
      icon: "🩺",
      color: "#1C2B3A",   # encre
      bg_light: "#D5DBE2",
      label: "Consultation"
    },
    "exam" => {
      icon: "🧪",
      color: "#5C6B7A",   # ardoise
      bg_light: "#DDE2E8",
      label: "Examen"
    },
    "treatment" => {
      icon: "💊",
      color: "#84B59F",   # sauge
      bg_light: "#DCE9E1",
      label: "Traitement"
    }
  }

  # Stats par type
  counts = {
    "symptom"      => @entries.count { |e| e.entry_type == "symptom" },
    "consultation" => @entries.count { |e| e.entry_type == "consultation" },
    "exam"         => @entries.count { |e| e.entry_type == "exam" },
    "treatment"    => @entries.count { |e| e.entry_type == "treatment" }
  }
%>

<div class="max-w-4xl mx-auto px-5 md:px-8 pt-10 md:pt-14 pb-20">

  <%# ─── EN-TÊTE ──────────────────────────────────────────────── %>
  <div class="flex items-start justify-between flex-wrap gap-4 mb-10">
    <div>
      <h1 class="font-serif font-semibold mb-2"
          style="font-size:clamp(2rem, 5vw, 2.75rem); color:var(--color-encre); line-height:1.1">
        Mon journal
      </h1>
      <% if @entries.any? %>
        <p style="color:var(--color-ardoise); font-size:0.98rem">
          <%= pluralize(@entries.size, "entrée") %> depuis
          <%= l(@entries.last.occurred_on, format: "%-d %B %Y") rescue @entries.last.occurred_on.strftime("%d/%m/%Y") %>
        </p>
      <% end %>
    </div>

    <%= link_to new_health_entry_path,
        class: "inline-flex items-center gap-2 px-5 py-3 rounded-full font-medium text-white transition-opacity hover:opacity-90",
        style: "background:var(--color-accent); font-size:0.95rem; box-shadow:0 4px 16px rgba(192,120,90,0.25)" do %>
      <span style="font-size:1.2rem; line-height:1">+</span>
      <span>Nouvelle entrée</span>
    <% end %>
  </div>

  <% if @entries.any? %>

    <%# ─── STATS PAR TYPE ─────────────────────────────────────── %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
      <% type_config.each do |type, cfg| %>
        <div class="rounded-2xl px-4 py-4 transition-all"
             style="background:white; border:1px solid var(--color-doux)">
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center rounded-full shrink-0"
                 style="width:2.5rem; height:2.5rem; background:<%= cfg[:bg_light] %>; font-size:1.1rem">
              <%= cfg[:icon] %>
            </div>
            <div class="min-w-0">
              <div class="font-serif font-semibold leading-tight"
                   style="font-size:1.5rem; color:var(--color-encre)">
                <%= counts[type] %>
              </div>
              <div style="color:var(--color-ardoise); font-size:0.82rem; line-height:1.2">
                <%= cfg[:label].pluralize(counts[type]) %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%# ─── CTA PISTES (si au moins 2 symptômes) ───────────────── %>
    <% if counts["symptom"] >= 2 %>
      <div class="rounded-2xl px-6 py-5 mb-10 flex items-center justify-between flex-wrap gap-4"
           style="background:var(--color-encre); color:white">
        <div class="flex-1" style="min-width:240px">
          <div class="font-serif font-semibold mb-1" style="font-size:1.15rem">
            Vos symptômes vous parlent&nbsp;?
          </div>
          <div style="color:rgba(255,255,255,0.72); font-size:0.92rem">
            Nommer peut analyser votre profil et vous proposer des pistes à explorer.
          </div>
        </div>
        <%= button_to generate_pistes_path,
            method: :post,
            class: "px-5 py-3 rounded-full font-medium transition-opacity hover:opacity-90 whitespace-nowrap",
            style: "background:var(--color-accent); color:white; font-size:0.92rem; border:none; cursor:pointer" do %>
          Analyser mes symptômes →
        <% end %>
      </div>
    <% elsif counts["symptom"] == 1 %>
      <div class="rounded-2xl px-6 py-4 mb-10"
           style="background:var(--color-creme); border:1px dashed var(--color-doux); color:var(--color-ardoise); font-size:0.9rem">
        💡 Ajoutez encore au moins 1 symptôme pour pouvoir analyser votre profil.
      </div>
    <% end %>

    <%# ─── FRISE TEMPORELLE ───────────────────────────────────── %>
    <div class="relative">

      <%# Ligne verticale de la frise %>
      <div class="absolute top-0 bottom-0 hidden md:block"
           style="left:1.1rem; width:2px; background:var(--color-doux)"></div>
      <div class="absolute top-0 bottom-0 md:hidden"
           style="left:0.8rem; width:2px; background:var(--color-doux)"></div>

      <% @entries_by_month.each do |month_label, entries| %>

        <%# Titre du mois %>
        <div class="relative mb-6 mt-10 first:mt-0">
          <div class="inline-block px-4 py-1.5 rounded-full ml-8 md:ml-12"
               style="background:var(--color-creme); border:1px solid var(--color-doux)">
            <span class="font-medium" style="color:var(--color-encre); font-size:0.85rem; letter-spacing:0.02em">
              <%= month_label.upcase %>
            </span>
          </div>
        </div>

        <%# Entrées du mois %>
        <% entries.each do |entry| %>
          <% cfg = type_config[entry.entry_type] %>
          <div class="relative mb-5 pl-8 md:pl-12">

            <%# Pastille sur la frise %>
            <div class="absolute flex items-center justify-center rounded-full"
                 style="left:0; top:0.9rem; width:1.6rem; height:1.6rem; background:<%= cfg[:bg_light] %>; border:2px solid white; box-shadow:0 0 0 1px <%= cfg[:color] %>40; z-index:1; font-size:0.85rem">
              <%= cfg[:icon] %>
            </div>

            <%# Carte de l'entrée %>
            <div class="rounded-2xl px-5 py-4 transition-all hover:shadow-md"
                 style="background:white; border:1px solid var(--color-doux); border-left:3px solid <%= cfg[:color] %>">

              <%# En-tête de carte %>
              <div class="flex items-start justify-between flex-wrap gap-2 mb-2">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-medium uppercase tracking-wide"
                        style="color:<%= cfg[:color] %>; font-size:0.7rem; letter-spacing:0.05em">
                    <%= cfg[:label] %>
                  </span>
                  <span style="color:var(--color-doux)">•</span>
                  <span style="color:var(--color-ardoise); font-size:0.85rem">
                    <%= l(entry.occurred_on, format: "%-d %B %Y") rescue entry.occurred_on.strftime("%d/%m/%Y") %>
                  </span>
                </div>

                <%# Actions edit/delete %>
                <div class="flex items-center gap-2">
                  <%= link_to edit_health_entry_path(entry),
                      class: "transition-opacity hover:opacity-60",
                      style: "color:var(--color-ardoise); font-size:0.82rem",
                      title: "Modifier" do %>
                    ✎
                  <% end %>
                  <%= button_to health_entry_path(entry),
                      method: :delete,
                      form: { data: { turbo_confirm: "Supprimer cette entrée ?" }, class: "inline" },
                      class: "transition-opacity hover:opacity-60",
                      style: "background:none; border:none; color:var(--color-ardoise); font-size:0.82rem; cursor:pointer; padding:0",
                      title: "Supprimer" do %>
                    ✕
                  <% end %>
                </div>
              </div>

              <%# Titre %>
              <h3 class="font-serif font-semibold mb-1"
                  style="color:var(--color-encre); font-size:1.05rem; line-height:1.3">
                <%= entry.title %>
              </h3>

              <%# Description %>
              <% if entry.description.present? %>
                <p class="leading-relaxed mb-3"
                   style="color:var(--color-ardoise); font-size:0.92rem">
                  <%= simple_format(entry.description, {}, wrapper_tag: "span") %>
                </p>
              <% end %>

              <%# Métadonnées par type %>
              <div class="flex items-center flex-wrap gap-2 mt-2">

                <% if entry.intensity %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full"
                        style="background:<%= cfg[:bg_light] %>; color:<%= cfg[:color] %>; font-size:0.78rem">
                    <span>Intensité</span>
                    <span class="font-semibold"><%= entry.intensity %>/5</span>
                    <span style="opacity:0.6"><%= entry.intensity_label %></span>
                  </span>
                <% end %>

                <% if entry.body_zone.present? %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full"
                        style="background:var(--color-creme); color:var(--color-ardoise); font-size:0.78rem; border:1px solid var(--color-doux)">
                    📍 <%= entry.body_zone.tr("_", " ").capitalize %>
                  </span>
                <% end %>

                <% if entry.doctor_specialty.present? %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full"
                        style="background:var(--color-creme); color:var(--color-ardoise); font-size:0.78rem; border:1px solid var(--color-doux)">
                    👨‍⚕️ <%= entry.doctor_specialty %>
                  </span>
                <% end %>

                <% if entry.exam_name.present? %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full"
                        style="background:var(--color-creme); color:var(--color-ardoise); font-size:0.78rem; border:1px solid var(--color-doux)">
                    🔬 <%= entry.exam_name %>
                  </span>
                <% end %>

                <% if entry.exam_result_available %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full"
                        style="background:#DCE9E1; color:#3F6A54; font-size:0.78rem">
                    ✓ Résultat disponible
                  </span>
                <% end %>

              </div>

              <%# Notes d'examen si présentes %>
              <% if entry.exam_result_notes.present? %>
                <div class="mt-3 pt-3" style="border-top:1px solid var(--color-doux)">
                  <div class="font-medium mb-1"
                       style="color:var(--color-encre); font-size:0.8rem">
                    Notes sur le résultat
                  </div>
                  <p style="color:var(--color-ardoise); font-size:0.88rem; line-height:1.5">
                    <%= simple_format(entry.exam_result_notes, {}, wrapper_tag: "span") %>
                  </p>
                </div>
              <% end %>

            </div>
          </div>
        <% end %>

      <% end %>

    </div>

  <% else %>

    <%# ─── ÉTAT VIDE ──────────────────────────────────────────── %>
    <div class="text-center py-16 px-6 rounded-2xl"
         style="background:white; border:1px dashed var(--color-doux)">

      <div class="inline-flex items-center justify-center rounded-full mb-6"
           style="width:5rem; height:5rem; background:var(--color-creme); font-size:2rem">
        📔
      </div>

      <h2 class="font-serif font-semibold mb-3"
          style="color:var(--color-encre); font-size:1.5rem">
        Votre journal est encore vierge
      </h2>

      <p class="max-w-md mx-auto leading-relaxed mb-8"
         style="color:var(--color-ardoise); font-size:0.98rem">
        Notez ce que vous ressentez, vos consultations, vos examens.
        Plus vous documentez, plus Nommer pourra vous proposer des pistes utiles.
      </p>

      <%= link_to new_health_entry_path,
          class: "inline-flex items-center gap-2 px-6 py-3 rounded-full font-medium text-white transition-opacity hover:opacity-90",
          style: "background:var(--color-accent); font-size:0.95rem; box-shadow:0 4px 16px rgba(192,120,90,0.25)" do %>
        <span style="font-size:1.2rem; line-height:1">+</span>
        <span>Ma première entrée</span>
      <% end %>

    </div>

  <% end %>

</div>

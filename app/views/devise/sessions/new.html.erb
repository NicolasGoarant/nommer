<%# ─────────────────────────────────────────────────────────────────────
    app/views/devise/sessions/new.html.erb
    Page de connexion — charte Nommer (crème / encre / ardoise / accent)
    Responsive : centré desktop, plein cadre mobile
───────────────────────────────────────────────────────────────────── %>

<div class="flex items-center justify-center px-5 py-12 md:py-20" style="min-height:calc(100vh - 4.5rem - 5rem)">
  <div class="w-full" style="max-width:28rem">

    <%# ── En-tête ── %>
    <div class="text-center mb-8">
      <h1 class="font-serif font-semibold mb-3"
          style="font-size:clamp(1.75rem, 4vw, 2.25rem); color:var(--color-encre); line-height:1.2">
        Bon retour
      </h1>
      <p class="leading-relaxed" style="color:var(--color-ardoise); font-size:0.98rem">
        Reprenez là où vous en étiez.
      </p>
    </div>

    <%# ── Carte du formulaire ── %>
    <div class="rounded-2xl px-6 py-8 md:px-8 md:py-10"
         style="background:white; border:1px solid var(--color-doux); box-shadow:0 8px 32px rgba(28,43,58,0.06)">

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-5" }) do |f| %>

        <%# ── Email ── %>
        <div class="flex flex-col gap-2">
          <%= f.label :email, "Adresse e-mail",
              class: "font-medium",
              style: "color:var(--color-encre); font-size:0.9rem" %>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "vous@exemple.fr",
              class: "w-full px-4 py-3 rounded-xl transition-all focus:outline-none",
              style: "background:var(--color-creme); border:1px solid var(--color-doux); color:var(--color-encre); font-size:0.98rem" %>
        </div>

        <%# ── Mot de passe ── %>
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <%= f.label :password, "Mot de passe",
                class: "font-medium",
                style: "color:var(--color-encre); font-size:0.9rem" %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Oublié ?", new_password_path(resource_name),
                  class: "transition-opacity hover:opacity-60",
                  style: "color:var(--color-accent); font-size:0.85rem; font-weight:500" %>
            <% end %>
          </div>
          <%= f.password_field :password,
              autocomplete: "current-password",
              placeholder: "••••••••",
              class: "w-full px-4 py-3 rounded-xl transition-all focus:outline-none",
              style: "background:var(--color-creme); border:1px solid var(--color-doux); color:var(--color-encre); font-size:0.98rem" %>
        </div>

        <%# ── Se souvenir ── %>
        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2.5 cursor-pointer">
            <%= f.check_box :remember_me,
                class: "w-4 h-4 rounded cursor-pointer",
                style: "accent-color:var(--color-accent)" %>
            <span style="color:var(--color-ardoise); font-size:0.92rem">
              Se souvenir de moi
            </span>
          </label>
        <% end %>

        <%# ── Bouton submit ── %>
        <%= f.submit "Se connecter",
            class: "w-full px-6 py-3.5 rounded-full font-medium text-white transition-opacity hover:opacity-90 cursor-pointer mt-2",
            style: "background:var(--color-accent); font-size:1rem; box-shadow:0 4px 16px rgba(192,120,90,0.25); border:none" %>

      <% end %>
    </div>

    <%# ── Lien création de compte ── %>
    <% if devise_mapping.registerable? %>
      <div class="text-center mt-6" style="font-size:0.95rem; color:var(--color-ardoise)">
        Pas encore de compte&nbsp;?
        <%= link_to "Créer un compte", new_registration_path(resource_name),
            class: "font-medium transition-opacity hover:opacity-70 ml-1",
            style: "color:var(--color-accent)" %>
      </div>
    <% end %>

    <%# ── Note rassurante ── %>
    <p class="text-center mt-8 leading-relaxed px-4"
       style="color:var(--color-ardoise); font-size:0.82rem">
      Nommer est un outil de documentation personnelle.<br>
      Vos données restent privées.
    </p>

  </div>
</div>

<%# ── Petite touche : focus visible cohérent avec la charte ── %>
<style>
  input:focus, textarea:focus {
    border-color: var(--color-accent) !important;
    box-shadow: 0 0 0 3px rgba(192,120,90,0.15) !important;
  }
  input::placeholder {
    color: #B0B0A8;
  }
</style>

<%# ── CONSEIL SCIENTIFIQUE ──────────────────────────────────────────── %>
<%# Page de transparence sur la rigueur médicale du projet : engagement,
    processus de validation des fiches, composition (en cours), sources. %>

<div class="max-w-2xl mx-auto px-6 pt-20 pb-14">

  <%# ── HERO ── %>
  <p class="text-xs tracking-widest uppercase font-medium mb-4" style="color:var(--color-accent)">Légitimité médicale</p>
  <h1 class="font-serif font-semibold mb-4" style="font-size:clamp(1.8rem,4vw,2.5rem);color:var(--color-encre)">
    Conseil scientifique
  </h1>
  <p class="leading-relaxed mb-12" style="color:var(--color-ardoise);font-size:1.1rem">
    La rigueur médicale au cœur du projet.
  </p>

  <%# ── NOTRE ENGAGEMENT ── %>
  <div class="mb-12">
    <h2 class="font-serif font-semibold mb-4" style="font-size:1.2rem;color:var(--color-encre)">Notre engagement</h2>
    <p class="leading-relaxed" style="color:var(--color-ardoise);line-height:1.8">
      Nommer s'adresse à des personnes qui traversent des parcours médicaux difficiles.
      La qualité de l'information que nous proposons est donc une responsabilité, pas une option.
      Le Conseil scientifique veille à ce que chaque fiche pathologie repose sur des sources
      médicales solides, que le ton reste apaisé, et que la place du médecin soit toujours
      centrale dans le parcours de soin.
    </p>
  </div>

  <%# ── PROCESSUS DE VALIDATION ── %>
  <div class="mb-12">
    <h2 class="font-serif font-semibold mb-4" style="font-size:1.2rem;color:var(--color-encre)">Notre processus de validation</h2>
    <div class="rounded-2xl px-8 py-7" style="background:white;border:1px solid var(--color-doux);color:var(--color-ardoise);margin:0 1px">
      <p class="leading-relaxed mb-5">
        Chaque fiche pathologie suit un processus en plusieurs étapes :
      </p>
      <div class="space-y-5">
        <div class="flex gap-4">
          <span class="font-serif font-semibold shrink-0" style="color:var(--color-accent);font-size:1.1rem;line-height:1.4">1.</span>
          <p style="line-height:1.7"><strong style="color:var(--color-encre)">Rédaction</strong> à partir de sources médicales publiques (HAS, Orphanet, sociétés savantes françaises, associations de patients reconnues).</p>
        </div>
        <div class="flex gap-4">
          <span class="font-serif font-semibold shrink-0" style="color:var(--color-accent);font-size:1.1rem;line-height:1.4">2.</span>
          <p style="line-height:1.7"><strong style="color:var(--color-encre)">Relecture médicale</strong> par un praticien spécialiste de la pathologie.</p>
        </div>
        <div class="flex gap-4">
          <span class="font-serif font-semibold shrink-0" style="color:var(--color-accent);font-size:1.1rem;line-height:1.4">3.</span>
          <p style="line-height:1.7"><strong style="color:var(--color-encre)">Validation</strong> par le Conseil scientifique avant publication.</p>
        </div>
        <div class="flex gap-4">
          <span class="font-serif font-semibold shrink-0" style="color:var(--color-accent);font-size:1.1rem;line-height:1.4">4.</span>
          <p style="line-height:1.7"><strong style="color:var(--color-encre)">Traçabilité</strong> : chaque fiche affiche la date de sa dernière révision.</p>
        </div>
      </div>
    </div>
  </div>

  <%# ── COMPOSITION ── %>
  <div class="mb-12">
    <h2 class="font-serif font-semibold mb-4" style="font-size:1.2rem;color:var(--color-encre)">Composition</h2>
    <p class="leading-relaxed mb-4" style="color:var(--color-ardoise);line-height:1.8">
      Le Conseil scientifique de Nommer est en cours de constitution. Nous recherchons des
      médecins de différentes spécialités prêts à s'engager dans la construction d'un outil
      au service du parcours patient : médecine générale, gynécologie, neurologie,
      rhumatologie, psychiatrie, médecine des maladies rares, et toute autre spécialité
      concernée par l'errance diagnostique.
    </p>
    <p class="leading-relaxed" style="color:var(--color-ardoise);line-height:1.8">
      Vous êtes médecin et souhaitez en savoir plus ? Écrivez-nous :
      <a href="mailto:nicolas.goarant@hotmail.fr" class="hover:underline" style="color:var(--color-accent)">nicolas.goarant@hotmail.fr</a>.
    </p>
  </div>

  <%# ── SOURCES DE RÉFÉRENCE ── %>
  <div class="mb-12">
    <h2 class="font-serif font-semibold mb-4" style="font-size:1.2rem;color:var(--color-encre)">Nos sources de référence</h2>
    <p class="leading-relaxed mb-5" style="color:var(--color-ardoise);line-height:1.8">
      Nommer s'appuie sur les sources institutionnelles françaises et européennes :
    </p>
    <div class="rounded-2xl px-8 py-7 space-y-3" style="background:white;border:1px solid var(--color-doux);color:var(--color-ardoise);margin:0 1px;line-height:1.7">
      <p><strong style="color:var(--color-encre)">Haute Autorité de Santé (HAS)</strong> — recommandations de bonne pratique.</p>
      <p><strong style="color:var(--color-encre)">Orphanet</strong> — base européenne des maladies rares.</p>
      <p><strong style="color:var(--color-encre)">Vidal</strong> — référentiel des médicaments.</p>
      <p><strong style="color:var(--color-encre)">Sociétés savantes françaises</strong> — CNGOF, SFR, SFD, etc.</p>
      <p><strong style="color:var(--color-encre)">Associations de patients reconnues d'utilité publique</strong>.</p>
    </div>
  </div>

  <div style="height:1px;background:var(--color-doux)" class="mb-8"></div>
  <p style="color:var(--color-ardoise);font-size:0.85rem">
    Une question, une suggestion ? <a href="mailto:nicolas.goarant@hotmail.fr" class="hover:underline" style="color:var(--color-accent)">nicolas.goarant@hotmail.fr</a>
  </p>

</div>

<%# ── PARTENAIRES ────────────────────────────────────────────────────── %>
<%# Page destinée aux associations de patients, professionnels de santé
    et institutions. Décrit la posture de Nommer et les formes de
    collaboration ouvertes. Formulations positives, terracotta réservée
    au bouton d'action final et à l'accent du logo Nommer. %>

<div class="max-w-2xl mx-auto px-6 pt-16 pb-14">

  <%# ── HERO ── %>
  <%# Aplat crème légèrement teinté + filet ardoise pour donner de la respiration. %>
  <div class="rounded-3xl px-6 md:px-10 pt-9 pb-10 mb-12 relative overflow-hidden"
       style="background:linear-gradient(180deg, rgba(228,221,212,0.35) 0%, rgba(247,244,239,0) 90%);border:1px solid var(--color-doux)">
    <div class="flex items-center gap-3 mb-4">
      <span style="display:inline-block;width:32px;height:1px;background:var(--color-ardoise);opacity:0.55"></span>
      <p class="text-xs tracking-widest uppercase font-medium" style="color:var(--color-ardoise);margin:0">Partenaires</p>
    </div>
    <h1 class="font-serif font-semibold mb-4" style="font-size:clamp(1.8rem,4vw,2.5rem);color:var(--color-encre);line-height:1.15">
      Nommer &amp; les acteurs de santé
    </h1>
    <p class="leading-relaxed" style="color:var(--color-ardoise);font-size:1.1rem">
      Aider les personnes en errance médicale à mieux préparer leurs consultations,
      aux côtés des associations de patients, des professionnels de santé et des
      institutions qui les accompagnent au quotidien.
    </p>
  </div>

  <%# ── CE QUE NOMMER APPORTE À VOS PUBLICS ── %>
  <div class="mb-12">
    <h2 class="font-serif font-semibold mb-4" style="font-size:1.2rem;color:var(--color-encre)">
      Ce que Nommer apporte à vos publics
    </h2>
    <div class="rounded-2xl px-6 md:px-8 py-7 space-y-6"
         style="background:white;border:1px solid var(--color-doux);color:var(--color-ardoise);margin:0 1px;line-height:1.7">

      <%# 1. Préparation de consultation %>
      <div class="flex items-start gap-4">
        <span class="shrink-0 mt-1" style="color:var(--color-ardoise)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </span>
        <p class="flex-1">
          <strong style="color:var(--color-encre)">Préparation de consultation</strong> —
          l'outil aide chaque personne à mettre des mots sur ce qu'elle traverse
          et à arriver préparée chez son médecin. Le diagnostic reste au médecin.
        </p>
      </div>

      <%# 2. Fiches pathologies documentées %>
      <div class="flex items-start gap-4">
        <span class="shrink-0 mt-1" style="color:var(--color-ardoise)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
        </span>
        <p class="flex-1">
          <strong style="color:var(--color-encre)">Fiches pathologies documentées</strong> —
          des repères clairs, des sources publiques de référence et des témoignages,
          pour mieux comprendre son parcours.
        </p>
      </div>

      <%# 3. Confidentialité des données %>
      <div class="flex items-start gap-4">
        <span class="shrink-0 mt-1" style="color:var(--color-ardoise)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <p class="flex-1">
          <strong style="color:var(--color-encre)">Confidentialité des données</strong> —
          descriptions personnelles et journal de bord restent strictement personnels,
          à l'usage exclusif de la personne concernée.
        </p>
      </div>

    </div>
  </div>

  <%# ── FORMES DE COLLABORATION POSSIBLES ── %>
  <div class="mb-12">
    <h2 class="font-serif font-semibold mb-4" style="font-size:1.2rem;color:var(--color-encre)">
      Formes de collaboration possibles
    </h2>
    <div class="space-y-4">

      <%# Carte 1 — Relecture & validation médicale %>
      <div class="rounded-2xl px-8 py-7" style="background:white;border:1px solid var(--color-doux);margin:0 1px">
        <div class="flex items-start justify-between gap-3 mb-3">
          <h3 class="font-serif font-semibold" style="font-size:1.05rem;color:var(--color-encre);line-height:1.35">
            Relecture &amp; validation médicale des fiches
          </h3>
          <span class="shrink-0 uppercase tracking-widest font-medium px-2.5 py-1 rounded-full"
                style="color:var(--color-ardoise);background:var(--color-creme);border:1px solid var(--color-doux);font-size:0.65rem">
            À venir
          </span>
        </div>
        <p style="color:var(--color-ardoise);line-height:1.7">
          Votre comité scientifique relit et valide les fiches pathologies pertinentes
          pour vos publics — traçabilité des sources, mention du relecteur,
          mise à jour datée.
        </p>
      </div>

      <%# Carte 2 — Fiches co-brandées %>
      <div class="rounded-2xl px-8 py-7" style="background:white;border:1px solid var(--color-doux);margin:0 1px">
        <div class="flex items-start justify-between gap-3 mb-3">
          <h3 class="font-serif font-semibold" style="font-size:1.05rem;color:var(--color-encre);line-height:1.35">
            Fiches co-brandées à diffuser dans vos canaux
          </h3>
          <span class="shrink-0 uppercase tracking-widest font-medium px-2.5 py-1 rounded-full"
                style="color:var(--color-ardoise);background:var(--color-creme);border:1px solid var(--color-doux);font-size:0.65rem">
            À venir
          </span>
        </div>
        <p style="color:var(--color-ardoise);line-height:1.7">
          Version PDF ou lien co-signé à distribuer en salles d'attente, permanences
          associatives, réseaux sociaux et lettres d'information — pour outiller
          vos usagers avec des repères validés.
        </p>
      </div>

      <%# Carte 3 — Orientation de vos publics %>
      <div class="rounded-2xl px-8 py-7" style="background:white;border:1px solid var(--color-doux);margin:0 1px">
        <div class="flex items-start justify-between gap-3 mb-3">
          <h3 class="font-serif font-semibold" style="font-size:1.05rem;color:var(--color-encre);line-height:1.35">
            Orientation de vos publics vers un outil gratuit et sans inscription
          </h3>
          <span class="shrink-0 uppercase tracking-widest font-medium px-2.5 py-1 rounded-full"
                style="color:var(--color-ardoise);background:var(--color-creme);border:1px solid var(--color-doux);font-size:0.65rem">
            À venir
          </span>
        </div>
        <p style="color:var(--color-ardoise);line-height:1.7">
          Un lien à partager avec les personnes que vous accompagnez : Nommer reste
          gratuit, sans inscription, et respectueux de leurs données.
        </p>
      </div>

    </div>
  </div>

  <%# ── DES SUPPORTS À DIFFUSER ─────────────────────────────────────── %>
  <%# Aperçus CSS uniquement : un flyer A5 portrait + deux publications carrées
      pour réseaux sociaux. Placeholders "votre logo ici" pour évoquer le
      co-branding sans engager un design final. %>
  <div class="mb-14">
    <div class="flex items-start justify-between gap-3 mb-2">
      <h2 class="font-serif font-semibold" style="font-size:1.2rem;color:var(--color-encre)">
        Des supports à diffuser
      </h2>
      <span class="shrink-0 uppercase tracking-widest font-medium px-2.5 py-1 rounded-full"
            style="color:var(--color-ardoise);background:var(--color-creme);border:1px solid var(--color-doux);font-size:0.65rem">
        À venir
      </span>
    </div>
    <p class="leading-relaxed mb-7" style="color:var(--color-ardoise);line-height:1.7">
      Quelques exemples de supports que nous pourrons co-construire, personnalisés
      à vos couleurs et à votre logo.
    </p>

    <%# Toutes les maquettes centrées dans un même conteneur pour un rendu cohérent. %>
    <div class="max-w-sm mx-auto space-y-5">

      <%# APERÇU 1 — Flyer A5 portrait %>
      <div>
        <p class="uppercase tracking-widest font-medium mb-2 text-center"
           style="color:var(--color-ardoise);opacity:0.7;font-size:0.62rem">
          Aperçu — Flyer A5
        </p>
        <div class="rounded-lg overflow-hidden mx-auto"
             style="background:linear-gradient(135deg, rgba(228,221,212,0.35) 0%, white 65%);
                    border:1px solid var(--color-doux);
                    box-shadow:0 6px 24px rgba(28,43,58,0.08);
                    padding:1.15rem">
          <%# Header brand %>
          <div class="flex items-center gap-1.5 mb-3">
            <svg viewBox="0 0 32 32" width="14" height="14" aria-hidden="true">
              <circle cx="16" cy="16" r="14" fill="#1C2B3A"/>
              <circle cx="16" cy="16" r="5" fill="#C0785A"/>
              <circle cx="16" cy="16" r="2" fill="#F7F4EF"/>
            </svg>
            <span class="font-serif font-semibold" style="color:var(--color-encre);font-size:0.8rem">Nommer</span>
          </div>
          <%# Title + errance %>
          <h4 class="font-serif font-semibold mb-0.5" style="color:var(--color-encre);font-size:1.05rem;line-height:1.15">
            Fibromyalgie
          </h4>
          <p class="mb-3" style="color:var(--color-ardoise);font-size:0.6rem;line-height:1.3">
            Environ 6 ans d'errance médicale en moyenne
          </p>
          <%# Symptômes list %>
          <p class="font-semibold mb-1" style="color:var(--color-encre);font-size:0.66rem">Symptômes fréquents</p>
          <ul class="space-y-0.5 mb-3" style="color:var(--color-ardoise);font-size:0.62rem;line-height:1.35">
            <li>• Douleurs diffuses</li>
            <li>• Fatigue persistante</li>
            <li>• Troubles du sommeil</li>
            <li>• Sensibilité accrue</li>
          </ul>
          <%# Quote %>
          <div class="rounded px-2 py-1.5 mb-3"
               style="background:var(--color-creme);border-left:2px solid var(--color-encre)">
            <p class="italic" style="color:var(--color-encre);font-size:0.6rem;line-height:1.35">
              « Chaque jour, un poids invisible pesait sur mes épaules. »
            </p>
            <p class="mt-0.5" style="color:var(--color-ardoise);font-size:0.53rem">— M. L.</p>
          </div>
          <%# À demander à votre médecin %>
          <div class="mb-3">
            <p class="font-semibold mb-0.5" style="color:var(--color-encre);font-size:0.66rem">
              À demander à votre médecin :
            </p>
            <p style="color:var(--color-ardoise);font-size:0.6rem;line-height:1.35">
              Un examen des points douloureux et un bilan biologique d'orientation.
            </p>
          </div>
          <%# Bottom : QR + URL, puis placeholder logo — directement sous le bloc précédent %>
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <%# QR code stylisé — SVG inline, 9x9 avec 3 finder patterns + data cells %>
              <svg viewBox="0 0 9 9" width="34" height="34" shape-rendering="crispEdges"
                   style="color:var(--color-encre);flex-shrink:0" fill="currentColor" aria-hidden="true">
                <%# Finder pattern top-left %>
                <rect x="0" y="0" width="3" height="3"/>
                <rect x="1" y="1" width="1" height="1" fill="white"/>
                <%# Finder pattern top-right %>
                <rect x="6" y="0" width="3" height="3"/>
                <rect x="7" y="1" width="1" height="1" fill="white"/>
                <%# Finder pattern bottom-left %>
                <rect x="0" y="6" width="3" height="3"/>
                <rect x="1" y="7" width="1" height="1" fill="white"/>
                <%# Data cells (motif stylisé) %>
                <rect x="4" y="0" width="1" height="1"/>
                <rect x="3" y="1" width="1" height="1"/>
                <rect x="5" y="1" width="1" height="1"/>
                <rect x="4" y="2" width="1" height="1"/>
                <rect x="0" y="4" width="1" height="1"/>
                <rect x="2" y="4" width="1" height="1"/>
                <rect x="3" y="3" width="1" height="1"/>
                <rect x="4" y="4" width="1" height="1"/>
                <rect x="5" y="3" width="1" height="1"/>
                <rect x="6" y="4" width="1" height="1"/>
                <rect x="8" y="4" width="1" height="1"/>
                <rect x="1" y="5" width="1" height="1"/>
                <rect x="3" y="5" width="1" height="1"/>
                <rect x="5" y="5" width="1" height="1"/>
                <rect x="7" y="5" width="1" height="1"/>
                <rect x="4" y="6" width="1" height="1"/>
                <rect x="6" y="6" width="1" height="1"/>
                <rect x="8" y="6" width="1" height="1"/>
                <rect x="5" y="7" width="1" height="1"/>
                <rect x="7" y="7" width="1" height="1"/>
                <rect x="4" y="8" width="1" height="1"/>
                <rect x="6" y="8" width="1" height="1"/>
                <rect x="8" y="8" width="1" height="1"/>
              </svg>
              <div>
                <p class="font-semibold" style="color:var(--color-encre);font-size:0.72rem;line-height:1">
                  nommer.app
                </p>
                <p class="mt-0.5" style="color:var(--color-ardoise);font-size:0.55rem;line-height:1.2">
                  Préparer sa consultation.
                </p>
              </div>
            </div>
            <div class="rounded flex items-center justify-center text-center py-2.5 px-2"
                 style="border:1px dashed var(--color-ardoise);opacity:0.65">
              <span class="uppercase tracking-widest" style="color:var(--color-ardoise);font-size:0.55rem">
                votre logo ici
              </span>
            </div>
          </div>
        </div>
      </div>

      <%# APERÇUS 2 & 3 — deux publications carrées %>
      <div class="grid grid-cols-2 gap-3">

        <%# APERÇU 2 — social square "Et si c'était ça ?" %>
        <div>
          <p class="uppercase tracking-widest font-medium mb-2 text-center"
             style="color:var(--color-ardoise);opacity:0.7;font-size:0.55rem;line-height:1.3">
            Aperçu — Réseaux sociaux
          </p>
          <div class="rounded-lg overflow-hidden flex flex-col justify-between"
               style="background:linear-gradient(135deg, rgba(228,221,212,0.35) 0%, white 65%);
                      border:1px solid var(--color-doux);
                      box-shadow:0 6px 24px rgba(28,43,58,0.08);
                      aspect-ratio:1/1;padding:0.85rem">
            <div class="flex items-center gap-1">
              <svg viewBox="0 0 32 32" width="10" height="10" aria-hidden="true">
                <circle cx="16" cy="16" r="14" fill="#1C2B3A"/>
                <circle cx="16" cy="16" r="5" fill="#C0785A"/>
                <circle cx="16" cy="16" r="2" fill="#F7F4EF"/>
              </svg>
              <span class="font-serif font-semibold" style="color:var(--color-encre);font-size:0.6rem">Nommer</span>
            </div>
            <div class="flex-1 flex flex-col justify-center items-center text-center px-1">
              <p class="font-serif font-semibold mb-1" style="color:var(--color-encre);font-size:0.95rem;line-height:1.1">
                Et si c'était ça&nbsp;?
              </p>
              <p style="color:var(--color-ardoise);font-size:0.5rem;line-height:1.35">
                Un outil pour préparer<br>votre prochaine consultation.
              </p>
            </div>
            <div class="rounded flex items-center justify-center py-1 px-1"
                 style="border:1px dashed var(--color-ardoise);opacity:0.65">
              <span class="uppercase tracking-widest" style="color:var(--color-ardoise);font-size:0.42rem">
                votre logo ici
              </span>
            </div>
          </div>
        </div>

        <%# APERÇU 3 — social square "7 ans" %>
        <div>
          <p class="uppercase tracking-widest font-medium mb-2 text-center"
             style="color:var(--color-ardoise);opacity:0.7;font-size:0.55rem;line-height:1.3">
            Aperçu — Réseaux sociaux
          </p>
          <div class="rounded-lg overflow-hidden flex flex-col justify-between"
               style="background:linear-gradient(135deg, rgba(228,221,212,0.35) 0%, white 65%);
                      border:1px solid var(--color-doux);
                      box-shadow:0 6px 24px rgba(28,43,58,0.08);
                      aspect-ratio:1/1;padding:0.85rem">
            <div class="flex items-center gap-1">
              <svg viewBox="0 0 32 32" width="10" height="10" aria-hidden="true">
                <circle cx="16" cy="16" r="14" fill="#1C2B3A"/>
                <circle cx="16" cy="16" r="5" fill="#C0785A"/>
                <circle cx="16" cy="16" r="2" fill="#F7F4EF"/>
              </svg>
              <span class="font-serif font-semibold" style="color:var(--color-encre);font-size:0.6rem">Nommer</span>
            </div>
            <div class="flex-1 flex flex-col justify-center items-center text-center px-1">
              <p class="font-serif font-semibold" style="color:var(--color-encre);font-size:1.7rem;line-height:1">
                7 ans
              </p>
              <p class="mt-1" style="color:var(--color-ardoise);font-size:0.5rem;line-height:1.35">
                d'errance médicale<br>en moyenne avant<br>un diagnostic.
              </p>
            </div>
            <div class="rounded flex items-center justify-center py-1 px-1"
                 style="border:1px dashed var(--color-ardoise);opacity:0.65">
              <span class="uppercase tracking-widest" style="color:var(--color-ardoise);font-size:0.42rem">
                votre logo ici
              </span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <p class="italic text-center mt-6" style="color:var(--color-ardoise);font-size:0.92rem;line-height:1.6">
      Supports co-brandés, personnalisables à vos couleurs et votre logo —
      à construire ensemble.
    </p>
  </div>

  <%# ── UNE DÉMARCHE EXIGEANTE ── %>
  <div class="mb-14">
    <h2 class="font-serif font-semibold mb-4" style="font-size:1.2rem;color:var(--color-encre)">
      Une démarche exigeante
    </h2>
    <p class="leading-relaxed" style="color:var(--color-ardoise);line-height:1.8">
      Nous construisons la validation médicale de nos fiches avec des cliniciens
      et les comités scientifiques d'associations de patients. Nommer respecte
      le RGPD et prépare une migration vers un hébergeur certifié HDS en France.
      Le positionnement est clair : préparer la consultation, en laissant le
      diagnostic au médecin.
    </p>
  </div>

  <%# ── CTA FINAL ── %>
  <div class="text-center pt-4">
    <%= link_to "Discutons de votre contexte", contact_path,
        class: "inline-block px-8 py-3.5 rounded-full font-medium text-white transition-opacity hover:opacity-85",
        style: "background:var(--color-accent);font-size:1rem" %>
  </div>

</div>

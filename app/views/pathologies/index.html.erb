<%# ─── HERO ──────────────────────────────────────────────────────────────── %>
<div class="relative flex items-center justify-center overflow-hidden hero-section">
  <div class="absolute inset-0">
    <img src="<%= asset_path('main_epaule.jpg') %>"
         alt="" class="w-full h-full object-cover"
         style="filter:brightness(0.78) saturate(0.9);object-position:center 20%">
  </div>
  <div class="absolute bottom-0 left-0 right-0 pointer-events-none" style="line-height:0"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none" style="display:block;width:100%;height:80px"><path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#F7F4EF"/></svg></div>
  <div class="hero-content relative z-10 text-center px-6 w-full max-w-2xl mx-auto">
    <div class="rounded-3xl md:px-10 md:py-10" style="background:transparent" id="hero-card">
    <style>
      @media (min-width: 768px) {
        #hero-card {
          background: rgba(28,43,58,0.52) !important;
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border: 1px solid rgba(255,255,255,0.12);
        }
      }
    </style>
    <h1 class="font-serif font-semibold leading-tight mb-6 text-white"
        style="font-size:clamp(2.2rem,5vw,4rem);text-shadow:0 2px 16px rgba(0,0,0,0.7)">
      Et si c'était ça&nbsp;?
    </h1>
    <p class="leading-relaxed mb-8 mx-auto"
       style="color:rgba(255,255,255,0.95);font-size:1.05rem;text-shadow:0 1px 10px rgba(0,0,0,0.8)">
      En France, 8 à 12 millions de personnes souffrent d'une pathologie
      qui tarde des années à être diagnostiquée —
      c'est ce qu'on appelle <em style="color:white;font-style:normal;font-weight:700">l'errance médicale</em>.
      <br><br>
      Nommer vous aide à mettre des mots sur ce que vous ressentez,
      et à arriver préparé chez votre médecin.
    </p>
    <p class="italic mx-auto mb-8"
       style="color:rgba(255,255,255,0.78);font-size:0.95rem;text-shadow:0 1px 8px rgba(0,0,0,0.7);font-family:Georgia,serif">
      Un outil pour préparer votre prochaine consultation, avec les bons mots.
    </p>
    <div class="flex items-center justify-center gap-4 flex-wrap">
      <%= link_to "Tester mes symptômes →", new_diagnostic_path,
          class: "px-8 py-4 rounded-full font-medium text-white transition-opacity hover:opacity-90",
          style: "background:var(--color-accent);box-shadow:0 4px 24px rgba(192,120,90,0.45);font-size:1rem" %>
      <%= link_to "Voir les pathologies ↓", "#pathologies",
          class: "px-8 py-4 rounded-full font-medium transition-colors",
          style: "border:2px solid white;color:white;background:rgba(255,255,255,0.15);font-size:1rem" %>
    </div>
    </div>
  </div>
</div>

<%# ─── PATHOLOGIES ────────────────────────────────────────────────────────── %>
<style>
  .hero-section { min-height: 60vh; padding-top: 2rem; padding-bottom: 4.5rem; }
  @media (min-width: 768px) {
    .hero-section { height: 85vh; max-height: 820px; padding-bottom: 0; padding-top: 0; }
    .hero-content { margin-top: -4rem; }
  }
  @media (min-width: 768px) {
    .pathology-card { flex: 0 0 calc(33.333% - 1rem); }
  }
</style>
<%# ─── STATS ──────────────────────────────────────────────────────────────── %>
<div class="max-w-5xl mx-auto px-6 py-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
    <div class="rounded-2xl px-6 py-8" style="background:white;border:1px solid var(--color-doux)">
      <p class="font-serif font-semibold mb-2" style="font-size:2.2rem;color:var(--color-encre)">8–12M</p>
      <p style="color:var(--color-ardoise);font-size:0.95rem;line-height:1.5">de Français en errance médicale, sans diagnostic pour leur pathologie</p>
    </div>
    <div class="rounded-2xl px-6 py-8" style="background:white;border:1px solid var(--color-doux)">
      <p class="font-serif font-semibold mb-2" style="font-size:2.2rem;color:var(--color-encre)">7 ans</p>
      <p style="color:var(--color-ardoise);font-size:0.95rem;line-height:1.5">d'errance médicale en moyenne avant d'obtenir un diagnostic</p>
    </div>
    <div class="rounded-2xl px-6 py-8" style="background:white;border:1px solid var(--color-doux)">
      <p class="font-serif font-semibold mb-2" style="font-size:2.2rem;color:var(--color-encre)"><%= Pathology.published.count %></p>
      <p style="color:var(--color-ardoise);font-size:0.95rem;line-height:1.5">pathologies documentées avec témoignages, symptômes et pistes</p>
    </div>
  </div>
</div>

<%# ─── CONFIANCE ──────────────────────────────────────────────────────────── %>
<%# Bloc de rassurance contextuelle : visible avant que l'utilisateur ne plonge
    dans la liste des fiches. Deux cartes (validation médicale + données privées)
    qui renvoient vers les pages dédiées du footer. %>
<div class="max-w-5xl mx-auto px-6 pb-12">
  <div class="text-center mb-8">
    <h2 class="font-serif font-semibold mb-2" style="font-size:1.55rem;color:var(--color-encre)">
      Un projet construit dans la rigueur
    </h2>
    <p style="color:var(--color-ardoise);font-size:0.95rem">
      Deux engagements au cœur de Nommer.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">

    <%# Carte 1 — Validation médicale %>
    <div class="rounded-2xl p-6 md:p-8 flex flex-col shadow-sm"
         style="background:white;border:1px solid var(--color-doux)">
      <div class="flex items-center justify-center mb-5 rounded-2xl"
           style="background:var(--color-creme);width:3.25rem;height:3.25rem;font-size:1.5rem">
        🩺
      </div>
      <h3 class="font-serif font-semibold mb-3" style="font-size:1.15rem;color:var(--color-encre)">
        Validation médicale
      </h3>
      <p class="leading-relaxed mb-5 flex-1" style="color:var(--color-ardoise);font-size:0.95rem">
        Chaque fiche repose sur des sources médicales solides : HAS, Orphanet,
        sociétés savantes. Notre Conseil scientifique veille à la rigueur du contenu.
      </p>
      <%= link_to "Découvrir notre démarche →", conseil_scientifique_path,
          class: "inline-block font-medium transition-opacity hover:opacity-70",
          style: "color:var(--color-accent);font-size:0.9rem" %>
    </div>

    <%# Carte 2 — Vos données vous appartiennent %>
    <div class="rounded-2xl p-6 md:p-8 flex flex-col shadow-sm"
         style="background:white;border:1px solid var(--color-doux)">
      <div class="flex items-center justify-center mb-5 rounded-2xl"
           style="background:var(--color-creme);width:3.25rem;height:3.25rem;font-size:1.5rem">
        🔒
      </div>
      <h3 class="font-serif font-semibold mb-3" style="font-size:1.15rem;color:var(--color-encre)">
        Vos données vous appartiennent
      </h3>
      <p class="leading-relaxed mb-5 flex-1" style="color:var(--color-ardoise);font-size:0.95rem">
        Hébergement français à venir, conformité RGPD, aucune revente. Vos
        descriptions et votre journal restent strictement personnels.
      </p>
      <%= link_to "En savoir plus sur la sécurité →", securite_donnees_path,
          class: "inline-block font-medium transition-opacity hover:opacity-70",
          style: "color:var(--color-accent);font-size:0.9rem" %>
    </div>

  </div>
</div>

<div id="pathologies" class="pt-4 pb-16">

  <% Pathology::CATEGORIES.each do |key, label| %>
    <% pathologies = @by_category[key] %>
    <% next if pathologies.blank? %>
    <div class="mb-8 md:mb-16">
      <div class="max-w-5xl mx-auto px-6 mb-6">
        <div class="flex items-center gap-4">
          <h2 class="font-serif font-semibold whitespace-nowrap" style="font-size:1.35rem;color:var(--color-encre)"><%= label %></h2>
          <div class="flex-1 h-px" style="background:var(--color-doux)"></div>
        </div>
      </div>
      <div class="flex flex-wrap justify-center gap-4 md:gap-6 max-w-5xl mx-auto px-3 md:px-6">
        <% pathologies.each do |p| %>
          <%
            testimonials = JSON.parse(p.testimonials || "[]") rescue []
            first_quote  = testimonials.first
            symptom_emojis = {
              "douleur" => "🔴", "douleurs" => "🔴",
              "fatigue" => "😔", "épuisement" => "😔",
              "sommeil" => "😴", "insomnie" => "😴", "réparateur" => "😴",
              "cognitif" => "🤯", "cognitifs" => "🤯", "mémoire" => "🤯",
              "concentration" => "🤯", "brouillard" => "🤯", "mental" => "🤯",
              "attention" => "🤯", "attentionnel" => "🤯",
              "tête" => "🧠", "céphalée" => "🧠", "migraine" => "🧠",
              "articulaire" => "🦴", "articulaires" => "🦴",
              "raideur" => "🦴", "gonflement" => "🦴", "luxations" => "🦴", "entorses" => "🦴",
              "règles" => "🩸", "menstruel" => "🩸", "saignement" => "🩸", "sang" => "🩸",
              "pelvienne" => "🩺", "pelviennes" => "🩺",
              "humeur" => "🌊", "impulsivité" => "🌊", "émotionnel" => "🌊", "irritabilité" => "🌊",
              "peau" => "🫧", "éruption" => "🫧", "acné" => "🫧", "cutané" => "🫧", "cutanée" => "🫧",
              "poids" => "⚖️",
              "cheveux" => "💇", "chute" => "💇",
              "digestif" => "🫁", "digestive" => "🫁", "digestives" => "🫁",
              "abdominale" => "🫁", "abdominales" => "🫁",
              "diarrhée" => "🫁", "constipation" => "🫁", "ballonnements" => "🫁",
              "nausées" => "🤢", "vomissements" => "🤢",
              "vision" => "👁️", "oculaire" => "👁️", "visuelle" => "👁️",
              "palpitations" => "💓", "cardiaque" => "💓", "tachycardie" => "💓",
              "anxiété" => "😰", "panique" => "😰", "anxieux" => "😰",
              "dépression" => "😞", "dépressif" => "😞",
              "étourdissements" => "💫", "malaises" => "💫", "vertiges" => "💫", "syncopes" => "💫",
              "sécheresse" => "🫙",
              "engourdissements" => "⚡", "fourmillements" => "⚡", "neuropathique" => "⚡",
              "paralysie" => "⚡", "spasmes" => "⚡",
              "fièvre" => "🌡️", "inflammation" => "🌡️", "sensibilité" => "🌡️",
              "infertilité" => "👶", "fertilité" => "👶",
              "hyperlaxité" => "🤸", "souplesse" => "🤸",
              "somnolence" => "😪", "endormissement" => "😪", "cataplexie" => "😪",
              "cycles" => "📅", "irréguliers" => "📅",
              "aphte" => "👄", "buccal" => "👄", "buccaux" => "👄",
              "pilosité" => "🪒", "excessive" => "🪒",
              "motrice" => "🚶", "équilibre" => "🚶", "difficultés" => "🚶",
              "urinaire" => "🚿", "urinaires" => "🚿",
              "soleil" => "☀️",
              "default" => "🩺"
            }
          %>

          <%# Card %>
          <%= link_to pathology_path(p.slug), class: "pathology-card flex flex-col rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 w-full",
               style: "background:white;border:1px solid var(--color-doux);text-decoration:none;color:inherit" do %>

            <%# ── IMAGE + OVERLAY ── %>
            <div class="relative overflow-hidden" style="height:12rem;background:var(--color-doux)">
              <% if p.image_url.present? %>
                <img src="<%= p.image_url %>" alt="<%= p.name %>"
                     class="absolute inset-0 w-full h-full object-cover"
                     style="filter:saturate(0.75) brightness(0.82)">
              <% end %>
              <div class="absolute inset-0"
                   style="background:linear-gradient(to top, rgba(28,43,58,0.95) 0%, rgba(28,43,58,0.4) 45%, transparent 100%)"></div>

              <%# Badge errance — coin haut gauche %>
              <% if p.avg_diagnosis_delay %>
                <div class="absolute top-3 left-3">
                  <span class="font-semibold px-3 py-1.5 rounded-full"
                        style="background:var(--color-accent);color:white;font-size:0.8rem">
                    ⏱ environ <%= p.avg_diagnosis_delay_text %> d'errance
                  </span>
                </div>
              <% end %>

              <%# Nom en bas %>
              <div class="absolute bottom-0 left-0 right-0 px-5 pb-4">
                <h3 class="font-serif font-semibold text-white" style="font-size:1.2rem;line-height:1.2">
                  <%= p.name %>
                </h3>
              </div>
            </div>

            <%# ── CORPS STRUCTURÉ ── %>
            <div class="flex flex-col flex-1 px-5 pt-4 pb-5 gap-4">

              <%# Nombre de personnes %>
              <% if p.nb_patients_label.present? %>
                <div class="flex items-center gap-2 pb-3"
                     style="border-bottom:1px solid var(--color-doux)">
                  <span>🫂</span>
                  <span class="font-medium" style="color:var(--color-encre);font-size:0.88rem">
                    <%= p.nb_patients_label %>
                  </span>
                </div>
              <% end %>

              <%# Citation patient %>
              <% if first_quote %>
                <div class="flex-1">
                  <p class="italic leading-relaxed"
                     style="color:#1C2B3A;font-size:0.9rem;font-weight:400">
                    «&nbsp;<%= first_quote["quote"] %>&nbsp;»
                  </p>
                  <p class="mt-2 font-medium"
                     style="color:var(--color-accent);font-size:0.82rem">
                    — <%= first_quote["initials"] %>
                  </p>
                </div>
              <% end %>

              <%# Symptômes — bullet list %>
              <div class="pt-3" style="border-top:1px solid var(--color-doux)">
                <ul class="space-y-1.5">
                  <% p.key_symptoms_array.first(4).each do |s| %>
                    <%
                      emoji = symptom_emojis["default"]
                      symptom_emojis.each do |key, val|
                        next if key == "default"
                        if s.downcase.include?(key)
                          emoji = val
                          break
                        end
                      end
                    %>
                    <li class="flex items-start gap-2" style="color:var(--color-ardoise);font-size:0.85rem">
                      <span class="shrink-0" style="margin-top:0.1rem"><%= emoji %></span>
                      <span><%= s %></span>
                    </li>
                  <% end %>
                </ul>
              </div>

              <%# CTA %>
              <div class="mt-auto block text-center py-2.5 rounded-xl font-medium"
                   style="background:var(--color-creme);color:var(--color-encre);font-size:0.88rem;border:1px solid var(--color-doux)">
                En savoir plus →
              </div>

            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<%# ─── CTA FINAL ──────────────────────────────────────────────────────────── %>
<div style="background:var(--color-encre)">
  <div class="text-center py-20 px-6 max-w-2xl mx-auto">
    <h2 class="font-serif font-semibold text-white mb-4" style="font-size:2rem">
      Vos symptômes vous parlent&nbsp;?
    </h2>
    <p class="mb-10 leading-relaxed" style="color:rgba(255,255,255,0.65);font-size:1rem">
      Décrivez librement ce que vous traversez.<br>
      Notre outil analyse votre profil et vous propose des pistes à explorer avec votre médecin.
    </p>
    <%= link_to "Analyser mes symptômes →", new_diagnostic_path,
        class: "inline-block px-10 py-4 rounded-full font-medium text-white transition-opacity hover:opacity-85",
        style: "background:var(--color-accent);font-size:1rem" %>
  </div>
</div>
